{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mealbets",
  "compatibility_date": "2026-09-07",
  "main": "./infrastructure/cloudflare/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  }
}
