{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mealbets",
  "compatibility_date": "2026-09-07",
  "main": "./infrastructure/cloudflare/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/"],
    "html_handling": "none"
  },
  "routes": [
    {
      "pattern": "mealbets.com",
      "custom_domain": true
    }
  ]
}
